# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already in .gitignore.

# Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase service_role key. SERVER ONLY.
# Must never be prefixed NEXT_PUBLIC_ and must never appear in a client
# component. It bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=
